name: Verify Human Identity

on:
  workflow_dispatch:

jobs:
  verify:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"

      - run: npm install -g clawhub

      - run: clawhub install verified-agent-identity

      - run: |
          if [ -f scripts/package.json ]; then
            cd scripts && npm install
          fi

      - run: node scripts/createNewEthereumIdentity.js

      - run: node scripts/manualLinkHumanToAgent.js \
          --challenge '{"name":"bagasety62","description":"bagasety62"}'
